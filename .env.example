# ==============================================================================
# Eduvia LMS — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or server/.env) and supply your own local credentials.
# Real credentials and secrets must NEVER be committed to version control.
# ==============================================================================

# Backend API Configuration
PORT=5001
DB_HOST=localhost
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=eduvia_lms_db
JWT_SECRET=your_jwt_secret_key_here

# Frontend Configuration (Optional)
VITE_API_URL=http://localhost:5001/api
