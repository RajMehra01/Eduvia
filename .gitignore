# ============================================================================
# Kairo PM — Version Control Ignore Rules
# ============================================================================

# Environment variables & secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/
/.pnp
.pnp.js

# Production builds & compiled assets
dist/
build/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories & IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Testing & Subagent artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/
browser/
scratch/

# Temporary files & caches
*.tmp
*.temp
.temp/
temp/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Local database files
*.sqlite
*.sqlite3
*.db
